# Secrets — never commit
.env
.env.local
tools/cloud/.uploaded.json

# Personal harness overrides (.claude/settings.json IS committed — it holds shared hooks)
.claude/settings.local.json

# Roblox build output
*.rbxlx
*.rbxl
*.rbxlx.lock
*.rbxmx.lock
/build/

# Toolchain
/.rokit/
~/.aftman/

# Wally packages — restored by `wally install`. wally.lock IS committed so
# every worker resolves the same versions.
/Packages/
/DevPackages/
/ServerPackages/

# Generated assets (regenerated by the P3 pipeline)
/tools/assetgen/out/
*.glb
*.fbx

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Stray Aftman manifest — shadows rokit shims and breaks `rojo` on PATH.
# rokit.toml is the real toolchain manifest.
aftman.toml
