# Normalize to LF in the repo. Without this, core.autocrlf=true hands a fresh
# Windows clone a CRLF scripts/check.sh, which bash rejects with `\r: command
# not found` — F1's "exits 0 on a clean clone" would fail on the clone only.
* text=auto eol=lf

# Binary — never touch these.
*.rbxl  binary
*.rbxlx binary
*.rbxm  binary
*.rbxmx binary
*.png   binary
*.jpg   binary
*.glb   binary
*.fbx   binary
*.ogg   binary
*.mp3   binary
