# Copy to .env and fill in. .env is gitignored — never commit it.
#
# Open Cloud API key from https://create.roblox.com/dashboard/credentials
# Needs the asset:write scope, and the key must be scoped to the creator below.
ROBLOX_OPEN_CLOUD_API_KEY=

# Creator the uploaded assets are billed to / owned by.
# Set ONE of these. Group takes precedence if both are set.
ROBLOX_CREATOR_USER_ID=
ROBLOX_CREATOR_GROUP_ID=

# This game
ROBLOX_UNIVERSE_ID=10694878805
ROBLOX_PLACE_ID=83234958310651
